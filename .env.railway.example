# Copy these names to the Railway application service. Never commit real values.
NODE_ENV=production
LOG_LEVEL=info

# Railway injects PORT. Do not set a fixed value unless troubleshooting.
PUBLIC_URL=https://your-app.up.railway.app
CORS_ORIGIN=https://your-app.up.railway.app
CDN_URL=https://your-app.up.railway.app

# Generate three independent random values in Railway. APP_DB_PASSWORD is used
# to provision the restricted runtime database role on every deploy.
JWT_SECRET=generate-a-long-random-value
MCP_JWT_SECRET=generate-another-long-random-value
ENCRYPTION_KEY=generate-another-long-random-value
APP_DB_PASSWORD=generate-another-long-random-value

# Replace `pgvector` if the database service has another Railway service name.
# MIGRATION_DATABASE_URL uses the pgvector service owner connection.
MIGRATION_DATABASE_URL=${{pgvector.DATABASE_URL}}
DATABASE_URL=postgresql://secv4_app:${{APP_DB_PASSWORD}}@${{pgvector.PGHOST}}:${{pgvector.PGPORT}}/${{pgvector.PGDATABASE}}
LANGGRAPH_DATABASE_URL=${{DATABASE_URL}}

SETUP_TOKEN_REQUIRED=true
SIGNUP_ENABLED=false
MCP_DCR_ENABLED=true
MCP_STDIO_ENABLED=false
SSRF_ALLOW_PRIVATE_TARGETS=false

# A Railway volume mounted at /app/storage persists these files across deploys.
QUOTES_STORAGE_DIR=/app/storage/quotes
BRANDING_STORAGE_DIR=/app/storage/branding

# Keep a single application replica while the in-process workers are enabled.
WEBHOOK_WORKER_ENABLED=true
SCHEDULER_WORKER_ENABLED=true
DEBOUNCE_WORKER_ENABLED=true
ALERT_WORKER_ENABLED=true

# Optional. Empty disables announcements and update checks against fazer.ai.
FAZER_AI_HUB_URL=https://app.fazer.ai
